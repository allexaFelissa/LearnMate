<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LearnMateApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearnMate">

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.material.MyMaterialsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.material.MaterialDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.summary.AiSummaryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.flashcard.FlashcardsActivity"
            android:exported="false" />

    </application>

</manifest>
